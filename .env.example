# Copy this file to .env and fill in real values. Never commit .env itself.

# Postgres connection (Railway/Render will give you this connection string)
DATABASE_URL=postgresql://user:password@localhost:5432/studiekompas

# Anthropic API key — the conversation engine
ANTHROPIC_API_KEY=sk-ant-...

# Voyage AI API key — used for embeddings (or swap for another embedding provider)
VOYAGE_API_KEY=pa-...

# App
APP_ENV=development
